---
import { INSTALL_COMMAND } from '../lib/install';

interface Props {
  /** Set the command as the display line a page is built around (Home). */
  display?: boolean;
}
const { display = false } = Astro.props;
---

{
  display ? (
    <div class="install display" data-install>
      {/* Same text as INSTALL_COMMAND; the span only carries the accent. The line scrolls inside its own box when it is wider than the screen. */}
      <code class="cmd" tabindex="0">npx @anscodelab/coding-<span class="hot">agent-kit</span></code>
      <button type="button" hidden>Copy command</button>
      <p class="status" role="status" aria-live="polite" data-status />
    </div>
  ) : (
    <div class="install" data-install>
      <code class="cmd">{INSTALL_COMMAND}</code>
      <button type="button" hidden>Copy command</button>
      <p class="status" role="status" aria-live="polite" data-status />
    </div>
  )
}

<script>
  import '../scripts/copy';
</script>

<style>
  .install {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: stretch;
    column-gap: var(--space-4);
    max-width: 100%;
  }
  .cmd {
    display: block;
    padding-block: var(--space-3);
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
    user-select: all;
  }
  button {
    min-width: var(--tap-min);
    min-height: var(--tap-min);
    padding-inline: var(--space-5);
    border: 0;
    border-radius: var(--radius-0);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    cursor: pointer;
    box-shadow: var(--shadow-2);
  }
  button:hover {
    background: var(--color-ink);
  }
  .status {
    grid-column: 1 / -1;
    min-height: 1.6em;
    margin: var(--space-2) 0 0;
    color: var(--color-signal);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  @media (max-width: 30rem) {
    .install {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-3);
    }
  }

  /* Display variant: the command is one line, 2 to 2.5 times the body size, with the button directly under it.
     The page headline stays the largest text on the first screen. */
  .display {
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-3);
    justify-items: start;
  }
  .display .cmd {
    max-width: 100%;
    padding-block: var(--space-2);
    font-size: 2.3rem;
    font-weight: var(--weight-bold);
    line-height: 1.1;
    letter-spacing: -0.03em;
    white-space: nowrap;
    overflow-x: auto;
    overflow-wrap: normal;
  }
  /* The button is revealed by script; keep its space so the content below does not jump when it appears. */
  .display button[hidden] {
    display: block;
    visibility: hidden;
  }
  .display .hot {
    color: var(--color-accent);
  }
</style>
