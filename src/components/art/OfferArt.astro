---
import '../../styles/art.css';
---

<svg class="art" viewBox="0 0 480 170" width="480" height="170" role="img" aria-labelledby="art-offer-title" aria-describedby="art-offer-desc" focusable="false">
  <title id="art-offer-title">Free, planned Pro Pack, services</title>
  <desc id="art-offer-desc">Three steps. Free is solid: the CLI and the skills, MIT licensed. The Pro Pack is drawn with a dashed outline because it is planned and not available yet. Services for teams are drawn as an outline.</desc>
  <rect class="f-ink" x="10" y="80" width="140" height="50" />
  <text class="big on-dark" x="24" y="112">Free</text>
  <rect class="ink dash join f-surface" x="170" y="50" width="140" height="80" />
  <text class="big" x="184" y="82">Pro Pack</text>
  <text class="sigtext" x="184" y="104">planned</text>
  <rect class="ink join f-surface" x="330" y="20" width="140" height="110" />
  <text class="big" x="344" y="52">Services</text>
  <path class="acc join draw" pathLength="1" d="M0 130 H480" />
  <text class="muted" x="10" y="158">MIT licensed</text>
  <text class="muted" x="170" y="158">not available</text>
  <text class="muted" x="330" y="158">for teams</text>
</svg>
