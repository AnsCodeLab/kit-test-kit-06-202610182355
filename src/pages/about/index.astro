---
import Base from '../../layouts/Base.astro';
import { getRepositoryUrl } from '../../lib/contact';
import AboutArt from '../../components/art/AboutArt.astro';
import { NEVER_DOES, LICENCE_CLAIMS, THIRD_PARTY_CLAIMS, assertClaims } from '../../lib/trust';

const all = [...NEVER_DOES, ...LICENCE_CLAIMS, ...THIRD_PARTY_CLAIMS];
assertClaims(all);
const repository = getRepositoryUrl();
---

<Base
  title="About and trust: licence, what the CLI never does, third-party notices"
  description="The Coding Agent Kit licence, what the CLI never does as its README states it, where third-party material comes from, and the repository to check it against."
>
  <div class="manifest">
    <section class="row" aria-labelledby="h-about">
      <p class="label" aria-hidden="true">/about</p>
      <div class="body">
        <div class="art-head">
          <div class="art-text">
            <h1 id="h-about">About and trust</h1>
            <p class="lede">
              Each statement below is quoted from the kit's own files, with the file named beside it. Check it against
              the repository.
            </p>
          </div>
          <div class="art-fig"><AboutArt /></div>
        </div>
      </div>
    </section>

    <section class="row" aria-labelledby="h-licence" data-about="licence">
      <p class="label" aria-hidden="true">/licence</p>
      <div class="body">
        <h2 id="h-licence">Licence</h2>
        <p>The kit is MIT licensed.</p>
        <p class="go"><a href="/license/">Read the licence text</a></p>
        <ul class="claims">
          {
            LICENCE_CLAIMS.map((c) => (
              <li data-claim={c.id}>
                <q>{c.quote}</q> <cite>{c.source}</cite>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="row" aria-labelledby="h-never" data-about="never">
      <p class="label" aria-hidden="true">/never</p>
      <div class="body">
        <h2 id="h-never">What the CLI never does</h2>
        <p>As the README states it, and how a run behaves:</p>
        <ul class="claims">
          {
            NEVER_DOES.map((c) => (
              <li data-claim={c.id}>
                <q>{c.quote}</q> <cite>{c.source}</cite>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="row" aria-labelledby="h-third" data-about="third-party">
      <p class="label" aria-hidden="true">/third-party</p>
      <div class="body">
        <h2 id="h-third">Third-party material</h2>
        <p>Which upstream projects the vendored skills come from, and under what licence, is listed on the third-party notices page.</p>
        <p class="go"><a href="/third-party/">Read the third-party notices</a></p>
        <ul class="claims">
          {
            THIRD_PARTY_CLAIMS.map((c) => (
              <li data-claim={c.id}>
                <q>{c.quote}</q> <cite>{c.source}</cite>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="row" aria-labelledby="h-repo" data-about="repository">
      <p class="label" aria-hidden="true">/repository</p>
      <div class="body">
        <h2 id="h-repo">Repository</h2>
        <p>The source, background and design notes are in the project repository.</p>
        <p class="cta">
          <a class="button" href={repository} data-repository>Open the project repository</a>
        </p>
      </div>
    </section>
  </div>
</Base>

<style>
  .manifest {
    border-top: 2px solid var(--color-ink);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-block: var(--space-7);
    border-bottom: 1px solid var(--color-rule);
  }
  .label {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-signal);
  }
  .body {
    min-width: 0;
  }
  .body > :last-child {
    margin-block-end: 0;
  }
  .lede {
    max-width: var(--measure);
    font-size: var(--text-lg);
  }
  .go {
    margin-block-start: 0;
  }
  .go a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }
  .claims {
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule);
  }
  .claims li {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-rule-soft);
    max-width: var(--measure);
    overflow-wrap: anywhere;
  }
  cite {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-style: normal;
    color: var(--color-ink-muted);
  }
  .cta {
    margin: 0;
  }
  .button {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding: var(--space-2) var(--space-5);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-weight: var(--weight-bold);
    text-decoration: none;
    box-shadow: var(--shadow-2);
  }
  .button:hover {
    background: var(--color-ink);
  }
  @media (min-width: 48rem) {
    .row {
      grid-template-columns: 9rem minmax(0, 1fr);
      column-gap: var(--space-6);
    }
    .label {
      margin: 0;
      padding-block-start: var(--space-2);
    }
  }
</style>
